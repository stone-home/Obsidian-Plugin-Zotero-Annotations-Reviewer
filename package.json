{
	"name": "zotero-annotation-reviewer",
	"version": "1.9.1",
	"description": "A plugin designed to review all annotations marked in Zotero and help select insightful notes to create a quick summary note.",
	"main": "src/main.js",
	"scripts": {
		"prepare": "husky",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"start": "node dist/index.js",
		"dev": "node esbuild.config.mjs",
		"test": "jest --passWithNoTests",
		"lint": "eslint src/**/*.ts",
		"format": "prettier --write \"src/**/*.{ts,json,md}\"",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"keywords": [],
	"author": "stone",
	"license": "MIT",
	"devDependencies": {
		"@eslint/js": "^9.39.5",
		"@semantic-release/exec": "^7.1.0",
		"@semantic-release/git": "^11.0.1",
		"@semantic-release/github": "^12.0.10",
		"@semantic-release/npm": "^13.2.0",
		"@types/jest": "^30.0.0",
		"@types/js-yaml": "^4.0.9",
		"@types/node": "^26.6.6",
		"@typescript-eslint/eslint-plugin": "8.72.2",
		"@typescript-eslint/parser": "8.72.2",
		"builtin-modules": "5.5.0",
		"esbuild": "^0.28.2",
		"eslint": "^9.39.5",
		"husky": "^9.1.7",
		"jest": "^30.5.2",
		"jest-environment-jsdom": "^30.5.2",
		"lint-staged": "^17.6.0",
		"obsidian": "^1.14.4",
		"prettier": "3.9.10",
		"semantic-release": "^25.0.9",
		"ts-jest": "^29.4.15",
		"tslib": "2.9.1",
		"typescript": "^5.9.3"
	},
	"overrides": {
		"@codemirror/state": "6.7.6",
		"@codemirror/view": "6.43.13",
		"@codemirror/language": "6.13.1",
		"@codemirror/commands": "6.11.1"
	},
	"dependencies": {
		"@codemirror/commands": "6.11.1",
		"@codemirror/lang-javascript": "^6.2.4",
		"@codemirror/lang-json": "^6.0.2",
		"@codemirror/language": "6.13.1",
		"@codemirror/lint": "^6.9.2",
		"@codemirror/state": "6.7.6",
		"@codemirror/theme-one-dark": "^6.1.3",
		"@codemirror/view": "6.43.13",
		"date-fns": "^4.1.0",
		"js-yaml": "^4.3.2",
		"markdown-note-orm": "^1.2.0",
		"winston": "^3.19.0"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/stone-home/Obsidian-Plugin-Zotero-Annotations-Reviewer"
	},
	"lint-staged": {
		"*.tex": [
			"prettier --write",
			"textlint"
		],
		"*.{ts,js,json,md}": [
			"prettier --write"
		]
	}
}
